# Copy to .env on the server, fill in real values, then: chmod 600 .env
# Generate secrets with: openssl rand -hex 32  (hex avoids URL-escaping issues)

POSTGRES_USER=carworld
POSTGRES_PASSWORD=
POSTGRES_DB=carworld

JWT_SECRET=

# Admin account created on the first start (empty database only)
ADMIN_EMAIL=admin@carworld.local
ADMIN_PASSWORD=

# Docker network shared with Caddy
PROXY_NETWORK=proxy

# Image tag to deploy: latest, or a commit tag like sha-abc1234
IMAGE_TAG=latest
