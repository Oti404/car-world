# Copy to ~/proiecte/carworld/.env on the server, fill in real values, then: chmod 600 .env
# Generate secrets with: openssl rand -hex 32  (hex avoids URL-escaping issues)

POSTGRES_USER=carworld
POSTGRES_PASSWORD=
POSTGRES_DB=carworld

JWT_SECRET=

# Admin account created on the first start (empty database only)
ADMIN_EMAIL=admin@carworld.local
ADMIN_PASSWORD=

# The image tag is NOT set here: the deploy workflow passes TAG=<commit sha>.
# Manual rollback: TAG=<older commit sha> docker compose up -d
