rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is an admin (requires double check as Storage rules can't query Firestore directly without custom claims)
    // For now, we rely on path naming conventions or user auth for basic protection
    
    match /news/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; // Ideally this would be isAdmin, but requires Custom Claims
    }
    
    match /reviews/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to upload car images (admin only in practice)
    match /cars/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
